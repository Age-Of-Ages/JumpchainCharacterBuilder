<Window x:Class="JumpchainCharacterBuilder.Views.JumpRandomizerSelectorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JumpchainCharacterBuilder.Views"
        xmlns:viewModel="clr-namespace:JumpchainCharacterBuilder.ViewModel"
        xmlns:data="clr-namespace:JumpchainCharacterBuilder.Model"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModel:JumpRandomizerSelectorViewModel, IsDesignTimeCreatable=True}"
        Title="Random Jump Selector" Height="600" Width="500"
        Cursor="" 
        WindowStyle="SingleBorderWindow" 
        Background="{DynamicResource Background}" 
        Foreground="{DynamicResource TextColor}"
        FontFamily="Lato" 
        FontSize="12" 
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Draw Random Jumps" Command="{Binding DrawCommand}" Style="{DynamicResource DataGridButton}"/>

            <TextBox Text="{Binding EntriesToPull, ValidatesOnNotifyDataErrors=True, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="16,0,0,0"/>
            <TextBlock Text="# of Jumps to select" Margin="4,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <CheckBox Content="File Randomizer Mode" IsChecked="{Binding FileRandomizerMode}"
                      HorizontalAlignment="Center"/>

            <ComboBox ItemsSource="{Binding InactiveJumpRandomizerLists}"
                      DisplayMemberPath="ListName"
                      SelectedItem="{Binding ActiveJumpRandomizerList}"
                      Width="120" Margin="0,4,0,0"/>
        </StackPanel>

        <ListView ItemsSource="{Binding WinningEntries}" x:Name="JumpListView"
                  Grid.Row="2"
                  Loaded="ListView_Loaded" SizeChanged="ListView_SizeChanged" 
                  ScrollViewer.ScrollChanged="ListView_ScrollChanged" Tag="0"
                  Visibility="{Binding FileRandomizerMode, Converter={StaticResource NegatedBoolToHiddenVis}}">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource ResourceKey={x:Type ListViewItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Header="Jump name" Width="Auto"
                                        CellTemplate="{StaticResource ResourceKey=GridViewDefaultColumn}"
                                        DisplayMemberBinding="{Binding JumpName}"/>
                        <GridViewColumn Header="Link" Width="65">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Visibility="{Binding JumpUri, Converter={StaticResource UriToVis}}"
                                               HorizontalAlignment="Center">
                                        <Hyperlink x:Name="JumpDocument_Hyperlink" NavigateUri="{Binding JumpUri}"
                                                   RequestNavigate="JumpDocument_RequestNavigate">
                                            <Hyperlink.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Copy link" IsCheckable="False" 
                                                              Command="{Binding Path=DataContext.CopyLinkCommand, Source={x:Reference JumpListView}}"
                                                              CommandParameter="{Binding JumpUri}"/>
                                                </ContextMenu>
                                            </Hyperlink.ContextMenu>
                                            Jump Link
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Add to Chain" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Create" HorizontalAlignment="Center" Command="{Binding Path=DataContext.AddJumpToChainCommand, Source={x:Reference JumpListView}}" 
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>

        <ListView ItemsSource="{Binding WinningFileEntries}" x:Name="JumpFileListView"
          Grid.Row="2"
          Loaded="ListView_Loaded" SizeChanged="ListView_SizeChanged" 
          ScrollViewer.ScrollChanged="ListView_ScrollChanged" Tag="0"
          Visibility="{Binding FileRandomizerMode, Converter={StaticResource BoolToHiddenVis}}">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource ResourceKey={x:Type ListViewItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Header="Jump name" Width="Auto"
                                CellTemplate="{StaticResource ResourceKey=GridViewDefaultColumn}"
                                DisplayMemberBinding="{Binding JumpName}"/>
                        <GridViewColumn Header="File" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Visibility="{Binding FilePath, Converter={StaticResource StringToVis}}"
                                       HorizontalAlignment="Center">
                                <Hyperlink x:Name="JumpDocument_Hyperlink"
                                           Command="{Binding Path=DataContext.OpenJumpFileLocationCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                           CommandParameter="{Binding FilePath}">
                                    File Location
                                </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Add to Chain" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Create" HorizontalAlignment="Center" Command="{Binding Path=DataContext.AddJumpToChainCommand, Source={x:Reference JumpListView}}" 
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
